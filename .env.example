# QuantumVest Database & Persistence Layer Configuration

# PostgreSQL Database (Primary)
DATABASE_URL="postgresql://username:password@localhost:5432/quantumvest?schema=public"
SHADOW_DATABASE_URL="postgresql://username:password@localhost:5432/quantumvest_shadow?schema=public"
DB_MAX_CONNECTIONS=20

# Redis Cache & Sessions
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""
REDIS_DEFAULT_TTL=3600

# MongoDB Events & Analytics
MONGODB_URL="mongodb://localhost:27017"
MONGODB_DB_NAME="quantumvest_events"

# IPFS Decentralized Storage
IPFS_HOST="localhost"
IPFS_PORT=5001
IPFS_PROTOCOL="http"
IPFS_GATEWAY="https://gateway.pinata.cloud/ipfs/"
IPFS_PINNING_ENABLED=true

# Pinata IPFS Pinning Service
PINATA_API_KEY=""
PINATA_SECRET_API_KEY=""

# Web3.Storage for Filecoin
WEB3_STORAGE_TOKEN=""

# Infura IPFS (Fallback)
INFURA_PROJECT_ID=""
INFURA_PROJECT_SECRET=""

# Supabase (Additional PostgreSQL)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Encryption
ENCRYPTION_KEY="your-secret-encryption-key-change-this"

# Application
NODE_ENV="development"
VITE_APP_NAME="QuantumVest"
VITE_APP_VERSION="1.0.0"

# Quantum Computing (Optional)
QUANTUM_SIMULATOR_URL=""
QUANTUM_HARDWARE_API_KEY=""

# AI/ML Services (Optional)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
HUGGINGFACE_API_KEY=""

# Payment Processing (Optional)
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# Monitoring & Analytics (Optional)
SENTRY_DSN=""
GOOGLE_ANALYTICS_ID=""
MIXPANEL_TOKEN=""

# Email Services (Optional)
SENDGRID_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""

# Geographic & Cultural Data
COUNTRY_API_KEY=""
CULTURAL_DATA_API_KEY=""

# Security
JWT_SECRET="your-jwt-secret-key"
SESSION_SECRET="your-session-secret-key"
CSRF_SECRET="your-csrf-secret-key"
