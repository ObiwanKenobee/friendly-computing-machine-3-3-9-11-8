# QuantumVest Production Environment Configuration
# Secure configuration for production deployment

# Application
NODE_ENV=production
PORT=5173
HOST=0.0.0.0

# Application Info
VITE_APP_NAME=QuantumVest
VITE_APP_VERSION=1.0.0
VITE_API_URL=https://api.quantumvest.com
VITE_APP_URL=https://quantumvest.com

# Database Configuration (Set via AWS Parameter Store)
# DATABASE_URL=postgresql://username:password@host:5432/database
# SHADOW_DATABASE_URL=postgresql://username:password@host:5432/database_shadow
DB_MAX_CONNECTIONS=50
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=600000

# Redis Configuration (Set via AWS Parameter Store)
# REDIS_URL=rediss://auth@host:6379
REDIS_DEFAULT_TTL=3600
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY=1000

# MongoDB Configuration (Set via AWS Parameter Store)
# MONGODB_URL=mongodb://username:password@host:27017
MONGODB_DB_NAME=quantumvest_events
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# IPFS Configuration
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
IPFS_PINNING_ENABLED=true
# PINATA_API_KEY=set_via_parameter_store
# PINATA_SECRET_API_KEY=set_via_parameter_store
# WEB3_STORAGE_TOKEN=set_via_parameter_store

# Security Configuration
# JWT_SECRET=set_via_parameter_store
# SESSION_SECRET=set_via_parameter_store
# CSRF_SECRET=set_via_parameter_store
# ENCRYPTION_KEY=set_via_parameter_store

# AWS Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET=quantumvest-production-assets
AWS_CLOUDFRONT_DOMAIN=cdn.quantumvest.com

# External APIs (Set via Parameter Store)
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_SECRET_KEY=sk_live_...
# PAYPAL_CLIENT_ID=set_via_parameter_store
# PAYPAL_CLIENT_SECRET=set_via_parameter_store

# AI/ML Services (Set via Parameter Store)
# OPENAI_API_KEY=set_via_parameter_store
# ANTHROPIC_API_KEY=set_via_parameter_store
# HUGGINGFACE_API_KEY=set_via_parameter_store

# Monitoring and Analytics
# SENTRY_DSN=set_via_parameter_store
SENTRY_ENVIRONMENT=production
SENTRY_SAMPLE_RATE=0.1
SENTRY_TRACES_SAMPLE_RATE=0.1

# Google Analytics
# GOOGLE_ANALYTICS_ID=set_via_parameter_store

# Mixpanel Analytics
# MIXPANEL_TOKEN=set_via_parameter_store

# Email Services (Set via Parameter Store)
# SENDGRID_API_KEY=set_via_parameter_store
# SMTP_HOST=set_via_parameter_store
# SMTP_PORT=587
# SMTP_USER=set_via_parameter_store
# SMTP_PASS=set_via_parameter_store

# Feature Flags
FEATURE_QUANTUM_OPTIMIZATION=true
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_IMPACT_TRACKING=true
FEATURE_CULTURAL_INVESTING=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_REALTIME_UPDATES=true

# Performance Configuration
CACHE_TTL_SHORT=300
CACHE_TTL_MEDIUM=1800
CACHE_TTL_LONG=3600
MAX_REQUEST_SIZE=10mb
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Security Headers
ENABLE_HSTS=true
ENABLE_CSP=true
ENABLE_REFERRER_POLICY=true
ENABLE_X_FRAME_OPTIONS=true
ENABLE_X_CONTENT_TYPE_OPTIONS=true

# CORS Configuration
CORS_ORIGIN=https://quantumvest.com,https://www.quantumvest.com,https://app.quantumvest.com
CORS_CREDENTIALS=true

# Session Configuration
SESSION_MAX_AGE=86400000
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# File Upload Configuration
MAX_FILE_SIZE=100mb
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,gif,svg,csv,xlsx,docx
UPLOAD_DESTINATION=s3

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true
BACKUP_ENCRYPTION=true

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_ROTATION=daily
LOG_MAX_FILES=30
LOG_MAX_SIZE=100m

# Health Check Configuration
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_GRACE_PERIOD=60000

# Circuit Breaker Configuration
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# Quantum Computing Configuration
QUANTUM_SIMULATOR_ENABLED=true
QUANTUM_HARDWARE_ENABLED=false
QUANTUM_CACHE_TTL=300
QUANTUM_ERROR_CORRECTION_ENABLED=true

# Geographic Configuration
DEFAULT_CURRENCY=USD
DEFAULT_TIMEZONE=UTC
SUPPORTED_COUNTRIES=US,CA,GB,DE,FR,JP,AU,SG,HK,IN,NG,KE,ZA,BR,MX
SUPPORTED_CURRENCIES=USD,EUR,GBP,JPY,CAD,AUD,SGD,HKD,INR,NGN,KES,ZAR,BRL,MXN

# Cultural Investment Configuration
CULTURAL_FRAMEWORKS_ENABLED=true
ESG_SCORING_ENABLED=true
IMPACT_TRACKING_ENABLED=true
COMMUNITY_VERIFICATION_ENABLED=true

# Compliance Configuration
GDPR_COMPLIANCE=true
CCPA_COMPLIANCE=true
SOX_COMPLIANCE=true
PCI_DSS_COMPLIANCE=true
DATA_RETENTION_PERIOD=2555

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=1000
API_TIMEOUT=30000
API_MAX_PAYLOAD_SIZE=10mb

# WebSocket Configuration
WS_ENABLED=true
WS_HEARTBEAT_INTERVAL=30000
WS_MAX_CONNECTIONS=10000
WS_COMPRESSION=true

# CDN Configuration
CDN_ENABLED=true
CDN_CACHE_TTL=86400
CDN_GZIP_ENABLED=true
CDN_BROTLI_ENABLED=true

# Metrics and Telemetry
METRICS_ENABLED=true
TELEMETRY_ENABLED=true
PROFILING_ENABLED=false
TRACING_ENABLED=true
TRACING_SAMPLE_RATE=0.1
